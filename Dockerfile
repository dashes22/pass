# Берем готовый образ с Node.js (на базе Alpine Linux — он легкий)
FROM node:20-alpine

# Создаем внутри контейнера рабочую папку /app
WORKDIR /app

# Копируем только файлы с зависимостями
COPY package*.json ./

# Устанавливаем зависимости (тут соберутся бинарники под Linux)
RUN npm install

# Копируем весь остальной код проекта
COPY . .

# Говорим, что контейнер будет слушать порт 3000
EXPOSE 3000

# Команда, которая запустится при старте контейнера
CMD ["node", "server.js"]